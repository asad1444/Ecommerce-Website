@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
    Layout = null; // Full-page layout
}
<!doctype html>
<html lang="en">
<head>
    <title>Register</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <link href="https://fonts.googleapis.com/css?family=Lato:300,400,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="~/template/css/style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body class="auth-page">
    <section class="auth-section">
        <aside class="auth-visual auth-visual-register">
            <a asp-controller="User" asp-action="Profile" class="auth-brand" aria-label="Coza Store home">
                <img src="~/templatewebsite/images/icons/logo-02.png" alt="Coza Store" />
            </a>
            <div class="auth-visual-copy">
                <span class="auth-visual-kicker">COZA STORE · A NEW CHAPTER</span>
                <p class="auth-visual-quote">Find your<br />own kind of style.</p>
                <p class="auth-visual-caption">Create an account and make the everyday a little more special.</p>
            </div>
            <span class="auth-visual-foot">THOUGHTFUL STYLE. EVERYDAY.</span>
        </aside>

        <main class="auth-panel">
            <a asp-controller="User" asp-action="Profile" class="auth-back-link">
                <span aria-hidden="true">&larr;</span> Back to the store
            </a>
            <div class="auth-form-wrap auth-form-register">
                <p class="auth-eyebrow">JOIN THE COMMUNITY</p>
                <h1 class="auth-title">Create your account</h1>
                <p class="auth-subtitle">A more considered shopping experience starts here.</p>

                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="login-form">
                    <div asp-validation-summary="ModelOnly" class="text-danger auth-validation-summary" role="alert"></div>
                    <div class="form-group">
                        <label asp-for="Input.FullName" class="auth-field-label">Full name</label>
                        <input asp-for="Input.FullName" class="form-control rounded-left" placeholder="Your full name" autocomplete="name" />
                        <span asp-validation-for="Input.FullName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Input.Email" class="auth-field-label">Email address</label>
                        <input asp-for="Input.Email" class="form-control rounded-left" placeholder="you@example.com" autocomplete="email" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.Password" class="auth-field-label">Password</label>
                        <input asp-for="Input.Password" class="form-control rounded-left" placeholder="Create a password" autocomplete="new-password" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.ConfirmPassword" class="auth-field-label">Confirm password</label>
                        <input asp-for="Input.ConfirmPassword" class="form-control rounded-left" placeholder="Enter your password again" autocomplete="new-password" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div class="form-group auth-submit-group">
                        <button type="submit" id="registerSubmit" class="btn btn-primary rounded submit p-3 px-5">
                            <span>Create account</span><span class="auth-button-arrow" aria-hidden="true">&rarr;</span>
                        </button>
                    </div>
                </form>

                <div class="auth-switch">
                    Already have an account? <a asp-page="./Login">Sign in</a>
                </div>
            </div>
            <p class="auth-legal">Your details stay private and secure.</p>
        </main>
    </section>

    <script src="~/template/js/jquery.min.js" asp-append-version="true"></script>
    <script src="~/template/js/popper.js" asp-append-version="true"></script>
    <script src="~/template/js/bootstrap.min.js" asp-append-version="true"></script>
    <script src="~/template/js/main.js" asp-append-version="true"></script>

    <!-- Validation Scripts -->
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
