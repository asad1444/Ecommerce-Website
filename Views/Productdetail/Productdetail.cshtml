@model loginlogout.Models.Product

@{
	Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
	<title>Product Detail</title>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<!--===============================================================================================-->
	<link rel="icon" type="image/png" href="~/templatewebsite/images/icons/favicon.png" />
	<!--===============================================================================================-->
	<link rel="stylesheet" type="text/css" href="~/templatewebsite/vendor/bootstrap/css/bootstrap.min.css">
	<!--===============================================================================================-->
	<link rel="stylesheet" type="text/css" href="~/templatewebsite/fonts/font-awesome-4.7.0/css/font-awesome.min.css">
	<!--===============================================================================================-->
	<link rel="stylesheet" type="text/css" href="~/templatewebsite/fonts/iconic/css/material-design-iconic-font.min.css">
	<!--===============================================================================================-->
	<link rel="stylesheet" type="text/css" href="~/templatewebsite/fonts/linearicons-v1.0.0/icon-font.min.css">
	<!--===============================================================================================-->
	<link rel="stylesheet" type="text/css" href="~/templatewebsite/vendor/animate/animate.css">
	<!--===============================================================================================-->
	<link rel="stylesheet" type="text/css" href="~/templatewebsite/vendor/css-hamburgers/hamburgers.min.css">
	<!--===============================================================================================-->
	<link rel="stylesheet" type="text/css" href="~/templatewebsite/vendor/animsition/css/animsition.min.css">
	<!--===============================================================================================-->
	<link rel="stylesheet" type="text/css" href="~/templatewebsite/vendor/select2/select2.min.css">
	<!--===============================================================================================-->
	<link rel="stylesheet" type="text/css" href="~/templatewebsite/vendor/daterangepicker/daterangepicker.css">
	<!--===============================================================================================-->
	<link rel="stylesheet" type="text/css" href="~/templatewebsite/vendor/slick/slick.css">
	<!--===============================================================================================-->
	<link rel="stylesheet" type="text/css" href="~/templatewebsite/vendor/MagnificPopup/magnific-popup.css">
	<!--===============================================================================================-->
	<link rel="stylesheet" type="text/css" href="~/templatewebsite/vendor/perfect-scrollbar/perfect-scrollbar.css">
	<!-- Material Design Iconic Font -->
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/material-design-iconic-font@2.2.0/dist/css/material-design-iconic-font.min.css">


	<!--===============================================================================================-->
	<link rel="stylesheet" type="text/css" href="~/templatewebsite/css/util.css">
	<link rel="stylesheet" type="text/css" href="~/templatewebsite/css/main.css">
	<link rel="stylesheet" type="text/css" href="~/css/storefront.css" asp-append-version="true">
	<!--===============================================================================================-->
</head>
<body class="animsition store-commerce-page store-legacy-chrome store-product-detail-page store-shared-nav">
	<partial name="_StorefrontNavbar" />

	<!-- Header -->
	<header class="header-v4">
		<!-- Header desktop -->
		<div class="container-menu-desktop">
			<!-- Topbar -->
			<div class="top-bar">
				<div class="content-topbar flex-sb-m h-full container">
					<div class="left-top-bar">
						Free shipping for standard order over Rs 100
					</div>
					
				</div>
			</div>

			<div class="wrap-menu-desktop how-shadow1">
				<nav class="limiter-menu-desktop container">

					<!-- Logo desktop -->
					<a href="#" class="logo">
						<img src="~/templatewebsite/images/icons/logo-01.png" alt="IMG-LOGO">
					</a>

					<!-- Menu desktop -->
					<div class="menu-desktop">
						<ul class="main-menu">
							<li>
								<a asp-controller="User" asp-action="Profile">Home</a>

							</li>

							<li class="active-menu">
								<a asp-controller="Shop" asp-action="Shop">Shop</a>
							</li>

							<li>
								<a asp-controller="Wishlist" asp-action="Index">Wishlist</a>
							</li>

							<li>
								<a asp-controller="Order" asp-action="MyOrders">Orders</a>
							</li>

							<li>
								<a asp-controller="Pages" asp-action="WebAbout">About</a>
							</li>

							<li>
								<a asp-controller="Contact" asp-action="Contact">Contact</a>

							</li>
						</ul>
					</div>

					<!-- Icon header -->
					<div class="wrap-icon-header flex-w flex-r-m">
						<div class="icon-header-item cl2 hov-cl1 trans-04 p-l-22 p-r-11 js-show-modal-search">
							<i class="zmdi zmdi-search"></i>
						</div>

						<div class="icon-header-item cl2 hov-cl1 trans-04 p-l-22 p-r-11 icon-header-noti js-show-cart" data-notify="@ViewBag.CountCartitem">
							<i class="zmdi zmdi-shopping-cart"></i>
						</div>

						
					</div>
				</nav>
			</div>
		</div>

		<!-- Header Mobile -->
		<div class="wrap-header-mobile">
			<!-- Logo moblie -->
			<div class="logo-mobile">
				<a href="index.html"><img src="~/templatewebsite/images/icons/logo-01.png" alt="IMG-LOGO"></a>
			</div>

			<!-- Icon header -->
			<div class="wrap-icon-header flex-w flex-r-m m-r-15">
				<div class="icon-header-item cl2 hov-cl1 trans-04 p-r-11 js-show-modal-search">
					<i class="zmdi zmdi-search"></i>
				</div>

				<div class="icon-header-item cl2 hov-cl1 trans-04 p-r-11 p-l-10 icon-header-noti js-show-cart" data-notify="@ViewBag.CountCartitem">
					<i class="zmdi zmdi-shopping-cart"></i>
				</div>

				
			</div>

			<!-- Button show menu -->
			<div class="btn-show-menu-mobile hamburger hamburger--squeeze">
				<span class="hamburger-box">
					<span class="hamburger-inner"></span>
				</span>
			</div>
		</div>


		<!-- Menu Mobile -->
		<div class="menu-mobile">
			<ul class="topbar-mobile">
				<li>
					<div class="left-top-bar">
						Free shipping for standard order over Rs 100
					</div>
				</li>

				
			</ul>

			<ul class="main-menu-m">
				<li>
					<a asp-controller="User" asp-action="Profile">Home</a>

				</li>

				<li class="active-menu">
					<a asp-controller="Shop" asp-action="Shop">Shop</a>
				</li>

				<li>
					<a asp-controller="Wishlist" asp-action="Index">Wishlist</a>
					<a asp-controller="Order" asp-action="MyOrders">Orders</a>
				</li>

				<li>
					<a asp-controller="Pages" asp-action="WebAbout">About</a>
				</li>

				<li>
					<a asp-controller="Contact" asp-action="Contact">Contact</a>

				</li>

			</ul>
		</div>

		<!-- Modal Search -->
		<div class="modal-search-header flex-c-m trans-04 js-hide-modal-search">
			<div class="container-search-header">
				<button class="flex-c-m btn-hide-modal-search trans-04 js-hide-modal-search">
					<img src="~/templatewebsite/images/icons/icon-close2.png" alt="CLOSE">
				</button>

				<form class="wrap-search-header flex-w p-l-15">
					<button class="flex-c-m trans-04">
						<i class="zmdi zmdi-search"></i>
					</button>
					<input class="plh3" type="text" name="search" placeholder="Search...">
				</form>
			</div>
		</div>
	</header>

	<!-- Cart -->
	<div class="wrap-header-cart js-panel-cart">
		<div class="s-full js-hide-cart"></div>

		<div class="header-cart flex-col-l p-l-65 p-r-25">
			<div class="header-cart-title flex-w flex-sb-m p-b-8">
				<span class="mtext-103 cl2">
					Your Cart
				</span>

				<div class="fs-35 lh-10 cl2 p-lr-5 pointer hov-cl1 trans-04 js-hide-cart">
					<i class="zmdi zmdi-close"></i>
				</div>
			</div>

			<div class="header-cart-content flex-w js-pscroll">
				<ul class="header-cart-wrapitem w-full">
					<li class="header-cart-item flex-w flex-t m-b-12">
						<div class="header-cart-item-img">
							<img src="~/templatewebsite/images/item-cart-01.jpg" alt="IMG">
						</div>

						<div class="header-cart-item-txt p-t-8">
							<a href="#" class="header-cart-item-name m-b-18 hov-cl1 trans-04">
								White Shirt Pleat
							</a>

							<span class="header-cart-item-info">
								1 x Rs 19.00
							</span>
						</div>
					</li>

					<li class="header-cart-item flex-w flex-t m-b-12">
						<div class="header-cart-item-img">
							<img src="~/templatewebsite/images/item-cart-02.jpg" alt="IMG">
						</div>

						<div class="header-cart-item-txt p-t-8">
							<a href="#" class="header-cart-item-name m-b-18 hov-cl1 trans-04">
								Converse All Star
							</a>

							<span class="header-cart-item-info">
								1 x Rs 39.00
							</span>
						</div>
					</li>

					<li class="header-cart-item flex-w flex-t m-b-12">
						<div class="header-cart-item-img">
							<img src="~/templatewebsite/images/item-cart-03.jpg" alt="IMG">
						</div>

						<div class="header-cart-item-txt p-t-8">
							<a href="#" class="header-cart-item-name m-b-18 hov-cl1 trans-04">
								Nixon Porter Leather
							</a>

							<span class="header-cart-item-info">
								1 x Rs 17.00
							</span>
						</div>
					</li>
				</ul>

				<div class="w-full">
					<div class="header-cart-total w-full p-tb-40">
						Total: Rs 75.00
					</div>

					<div class="header-cart-buttons flex-w w-full">
						<a href="shoping-cart.html" class="flex-c-m stext-101 cl0 size-107 bg3 bor2 hov-btn3 p-lr-15 trans-04 m-r-8 m-b-10">
							View Cart
						</a>

						<a href="shoping-cart.html" class="flex-c-m stext-101 cl0 size-107 bg3 bor2 hov-btn3 p-lr-15 trans-04 m-b-10">
							Check Out
						</a>
					</div>
				</div>
			</div>
		</div>
	</div>


	<!-- breadcrumb -->
	<div class="container">
		@if (TempData["StoreMessage"] is string storeMessage)
		{
			<div class="alert alert-success mt-4" role="status">@storeMessage</div>
		}
		@if (TempData["StoreError"] is string storeError)
		{
			<div class="alert alert-danger mt-4" role="alert">@storeError</div>
		}
		<div class="bread-crumb flex-w p-l-25 p-r-15 p-t-30 p-lr-0-lg">
			<a asp-controller="User" asp-action="Profile" class="stext-109 cl8 hov-cl1 trans-04">
				Home
				<i class="fa fa-angle-right m-l-9 m-r-10" aria-hidden="true"></i>
			</a>

			<a asp-controller="Shop" asp-action="Shop" class="stext-109 cl8 hov-cl1 trans-04">
				@Model.Category.Name
				<i class="fa fa-angle-right m-l-9 m-r-10" aria-hidden="true"></i>
			</a>

			<span class="stext-109 cl4">
				@Model.Name
			</span>
		</div>
	</div>


	<!-- Product Detail -->
	<section class="sec-product-detail bg0 p-t-65 p-b-60">


		<div class="container">

			<div class="row">

				<div class="col-md-6 col-lg-7 p-b-30">
					<div class="p-l-25 p-r-30 p-lr-0-lg">
						<div class="wrap-slick3 flex-sb flex-w">

							<div class="slick3 gallery-lb">
								<div class="wrap-pic-w pos-relative">
									<img src="~/ProductImages/@Model.ProductImage" alt="IMG-PRODUCT" height="400px">

									<a class="flex-c-m size-108 how-pos1 bor0 fs-16 cl10 bg0 hov-btn3 trans-04" href="~/ProductImages/@Model.ProductImage">
										<i class="fa fa-expand"></i>
									</a>
								</div>



							</div>

						</div>
					</div>
				</div>

				<div class="col-md-6 col-lg-5 p-b-30">
					<div class="p-r-50 p-t-5 p-lr-0-lg">
						<h4 class="mtext-105 cl2 js-name-detail p-b-14">
							@Model.Name
						</h4>

						<span class="mtext-106 cl2">
							@RupeeFormatter.Format(Model.Price)
						</span>

						<p class="stext-102 cl3 p-t-23">
							@Model.Description
						</p>

						<!--  -->



						<div class="store-product-purchase">
							<div class="store-product-actions">
								<form asp-controller="ShowCartItem" asp-action="AddToCart" method="post" class="store-add-to-cart-form">
									<input type="hidden" name="id" value="@Model.ProductId" />
									<input type="hidden" name="returnUrl" value="@Url.Action("ShowCartItem", "ShowCartItem")" />

									@if (Model.Stock > 0)
									{
										<div class="wrap-num-product flex-w" aria-label="Choose product quantity">
											<button type="button" class="btn-num-product-down cl8 hov-btn3 trans-04 flex-c-m" aria-label="Decrease quantity">
												<i class="fs-16 zmdi zmdi-minus" aria-hidden="true"></i>
											</button>
											<input class="mtext-104 cl3 txt-center num-product" type="number" name="quantity" value="1" min="1" max="@Model.Stock" step="1" inputmode="numeric" aria-label="Quantity" />
											<button type="button" class="btn-num-product-up cl8 hov-btn3 trans-04 flex-c-m" aria-label="Increase quantity">
												<i class="fs-16 zmdi zmdi-plus" aria-hidden="true"></i>
											</button>
										</div>
										<button type="submit" class="store-add-to-cart-button">
											Add to cart <i class="zmdi zmdi-shopping-cart ml-2" aria-hidden="true"></i>
										</button>
									}
									else
									{
										<p class="text-muted mb-0" role="status">Currently out of stock</p>
									}
								</form>
								<form asp-controller="Wishlist" asp-action="Add" method="post" class="store-product-wishlist">
									<input type="hidden" name="productId" value="@Model.ProductId" />
									<input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
									<button type="submit" class="btn btn-outline-dark rounded-pill">Save to wishlist</button>
								</form>
							</div>

							<div class="flex-w flex-m store-product-socials">
									<a href="#" class="fs-14 cl3 hov-cl1 trans-04 lh-10 p-lr-10 p-tb-5 m-r-10" title="Facebook">
										<i class="fa fa-facebook"></i>
									</a>
									<a href="#" class="fs-14 cl3 hov-cl1 trans-04 lh-10 p-lr-10 p-tb-5 m-r-10" title="Twitter">
										<i class="fa fa-twitter"></i>
									</a>
									<a href="#" class="fs-14 cl3 hov-cl1 trans-04 lh-10 p-lr-10 p-tb-5 m-r-10" title="Google Plus">
										<i class="fa fa-google-plus"></i>
									</a>
									<a href="#" class="fs-14 cl3 hov-cl1 trans-04 lh-10 p-lr-10 p-tb-5" title="Instagram">
										<i class="fa fa-instagram"></i>
									</a>
								</div>
							</div>
						</div>
					</div>
			</div>




			<div class="bor10 m-t-50 p-t-43 p-b-40">
				<!-- Tab01 -->
				<div class="tab01">
					<!-- Nav tabs -->
					<ul class="nav nav-tabs" role="tablist">
						<li class="nav-item p-b-10">
							<a class="nav-link active" data-toggle="tab" href="#description" role="tab">Description</a>
						</li>

						<li class="nav-item p-b-10">
							<a class="nav-link" data-toggle="tab" href="#reviews" role="tab">Reviews (1)</a>
						</li>
					</ul>

					<!-- Tab panes -->
					<div class="tab-content p-t-43">
						<!-- - -->
						<div class="tab-pane fade show active" id="description" role="tabpanel">
							<div class="how-pos2 p-lr-15-md">
								<p class="stext-102 cl6">
									@Model.LongDescription
								</p>
							</div>
						</div>

						<!-- - -->
						<div class="tab-pane fade" id="information" role="tabpanel">
							<div class="row">
								<div class="col-sm-10 col-md-8 col-lg-6 m-lr-auto">
									<ul class="p-lr-28 p-lr-15-sm">
										<li class="flex-w flex-t p-b-7">
											<span class="stext-102 cl3 size-205">
												Weight
											</span>

											<span class="stext-102 cl6 size-206">
												0.79 kg
											</span>
										</li>

										<li class="flex-w flex-t p-b-7">
											<span class="stext-102 cl3 size-205">
												Dimensions
											</span>

											<span class="stext-102 cl6 size-206">
												110 x 33 x 100 cm
											</span>
										</li>

										<li class="flex-w flex-t p-b-7">
											<span class="stext-102 cl3 size-205">
												Materials
											</span>

											<span class="stext-102 cl6 size-206">
												60% cotton
											</span>
										</li>

										<li class="flex-w flex-t p-b-7">
											<span class="stext-102 cl3 size-205">
												Color
											</span>

											<span class="stext-102 cl6 size-206">
												Black, Blue, Grey, Green, Red, White
											</span>
										</li>

										<li class="flex-w flex-t p-b-7">
											<span class="stext-102 cl3 size-205">
												Size
											</span>

											<span class="stext-102 cl6 size-206">
												XL, L, M, S
											</span>
										</li>
									</ul>
								</div>
							</div>
						</div>

						<!-- - -->
						<div class="tab-pane fade" id="reviews" role="tabpanel">
							<div class="row">
								<div class="col-sm-10 col-md-8 col-lg-6 m-lr-auto">
									<div class="p-b-30 m-lr-15-sm">
										<!-- Review -->
										<div class="flex-w flex-t p-b-68">
											<div class="wrap-pic-s size-109 bor0 of-hidden m-r-18 m-t-6">
												<img src="images/avatar-01.jpg" alt="AVATAR">
											</div>

											<div class="size-207">
												<div class="flex-w flex-sb-m p-b-17">
													<span class="mtext-107 cl2 p-r-20">
														Ariana Grande
													</span>

													<span class="fs-18 cl11">
														<i class="zmdi zmdi-star"></i>
														<i class="zmdi zmdi-star"></i>
														<i class="zmdi zmdi-star"></i>
														<i class="zmdi zmdi-star"></i>
														<i class="zmdi zmdi-star-half"></i>
													</span>
												</div>

												<p class="stext-102 cl6">
													Quod autem in homine praestantissimum atque optimum est, id deseruit. Apud ceteros autem philosophos
												</p>
											</div>
										</div>

										<!-- Add review -->
										<form class="w-full" asp-controller="Productdetail" asp-action="AddReview" method="post">
											<h5 class="mtext-108 cl2 p-b-7">
												Add a review
											</h5>

											<p class="stext-102 cl6">
												Your email address will not be published. Required fields are marked *
											</p>

											<div class="flex-w flex-m p-t-50 p-b-23">
												<span class="stext-102 cl3 m-r-16">
													Your Rating
												</span>

												<span class="wrap-rating fs-18 cl11 pointer">
													<i class="item-rating pointer zmdi zmdi-star-outline"></i>
													<i class="item-rating pointer zmdi zmdi-star-outline"></i>
													<i class="item-rating pointer zmdi zmdi-star-outline"></i>
													<i class="item-rating pointer zmdi zmdi-star-outline"></i>
													<i class="item-rating pointer zmdi zmdi-star-outline"></i>
													<input class="dis-none" type="number" name="Rating">
												</span>
											</div>

											<div class="row p-b-25">
												<div class="col-12 p-b-5">
													<label class="stext-102 cl3" for="review">Your review</label>
													<textarea class="size-110 bor8 stext-102 cl2 p-lr-20 p-tb-10" id="review" name="Comment"></textarea>
												</div>

												<div class="col-sm-6 p-b-5">
													<label class="stext-102 cl3" for="name">Name</label>
													<input class="size-111 bor8 stext-102 cl2 p-lr-20" id="name" name="Name" type="text">
												</div>

												<div class="col-sm-6 p-b-5">
													<label class="stext-102 cl3" for="email" >Email</label>
													<input class="size-111 bor8 stext-102 cl2 p-lr-20" name="Email"type="text">
												</div>
											</div>

											<button type="submit" class="flex-c-m stext-101 cl0 size-112 bg7 bor11 hov-btn3 p-lr-15 trans-04 m-b-10">
												Submit
											</button>
										</form>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>

			</div>
		</div>


		<div class="bg6 flex-c-m flex-w size-302 m-t-73 p-tb-15">
			<span class="stext-107 cl6 p-lr-25">
				SKU: JAK-01
			</span>

			<span class="stext-107 cl6 p-lr-25">
				Categories: @Model.Name, @Model.Category.Name
			</span>
		</div>
	</section>


	<!-- Related Products -->
	<section class="sec-relate-product bg0 p-t-45 p-b-105">
		<div class="container">
			<div class="p-b-45">
				<h3 class="ltext-106 cl5 txt-center">
					Related Products
				</h3>
			</div>

			<!-- Slide2 -->
			<div class="wrap-slick2">
				<div class="slick2">
					@foreach (var item in (List<loginlogout.Models.Product>)ViewBag.RelatedProducts)
					{
						<div class="item-slick2 p-l-15 p-r-15 p-t-15 p-b-15">
							<!-- Block2 -->
							<div class="block2">
								<div class="block2-pic hov-img0">
									<img src="~/ProductImages/@item.ProductImage" alt="@item.Name" loading="lazy">

									<a asp-controller="Productdetail" asp-action="Productdetail" asp-route-id="@item.ProductId" class="block2-btn flex-c-m stext-103 cl2 size-102 bg0 bor2 hov-btn1 p-lr-15 trans-04">
										Shop Now
									</a>
								</div>

								<div class="block2-txt flex-w flex-t p-t-14">
									<div class="block2-txt-child1 flex-col-l ">
