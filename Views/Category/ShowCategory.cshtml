@model IReadOnlyList<loginlogout.Models.Category>
@{
    ViewData["Title"] = "Categories";
    Layout = "~/Views/Shared/_Layoutcrud.cshtml";
}

<section class="admin-page-intro">
    <div>
        <span class="admin-page-kicker">CATALOG</span>
        <h1>Categories</h1>
        <p>Keep the store easy to browse with clear collections.</p>
    </div>
    <a asp-action="AddCategory" class="admin-primary-link"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add category</a>
</section>

<section class="admin-list-card">
    <div class="admin-list-toolbar">
        <div><strong>@Model.Count category(ies)</strong><span>Product collections currently in your store.</span></div>
    </div>
    <div class="admin-table-wrap">
        <table class="table">
            <thead><tr><th>Category</th><th>Image</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="3" class="text-center py-5 text-muted">No categories yet. Add one to organize your products.</td></tr>
                }
                else
                {
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td><strong>@category.Name</strong><small class="d-block text-muted">Collection #@category.CategoryId</small></td>
                            <td><img src="~/CategoryImages/@category.CategoryImage" alt="" /></td>
                            <td class="text-end text-nowrap">
                                <a class="admin-action-icon" asp-action="Edit" asp-route-id="@category.CategoryId" aria-label="Edit @category.Name"><i class="bi bi-pencil-square"></i></a>
                                <button type="button" class="admin-action-icon admin-action-delete" data-bs-toggle="modal" data-bs-target="#deleteConfirmationModal"
                                        data-delete-url="@Url.Action("Delete", "Category")" data-delete-id="@category.CategoryId"
                                        data-delete-type="category" data-delete-name="@category.Name" aria-label="Delete @category.Name">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>

<partial name="_DeleteConfirmationModal" />
